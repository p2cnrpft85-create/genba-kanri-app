rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function employee() { return signedIn() && profile().approved == true; }
  function admin() { return employee() && profile().role == 'admin'; }
  match /users/{userId} {
   allow create: if signedIn() && request.auth.uid == userId
     && request.resource.data.keys().hasOnly(['email','role','approved','createdAt'])
     && request.resource.data.email == request.auth.token.email
     && request.resource.data.role == 'employee'
     && request.resource.data.approved == false;
   allow get: if signedIn() && (request.auth.uid == userId || admin());
   allow list: if admin();
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
   allow delete: if false;
   match /freeMemos/{memoId} { allow read, write: if employee() && request.auth.uid == userId; }
  }
  match /shared/calendar { allow read, create, update: if employee(); allow delete: if false; }
  match /freeMemos/{memoId} { allow read, write: if employee(); }
  match /{document=**} { allow read, write: if false; }
 }
}
